# Workspace-level gitignore for Saga-Elite project
# This file applies to all subdirectories unless overridden by a more
# specific ignore file.

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (preserve .env.example templates)
.env
.env.local
.env.*.local
.env.production
!.env.example
!Client-Side/.env.example
!Server-side/.env.example
!e2e/.env.test.example

# Hosting & Platform artifacts
.vercel/
.netlify/

# Build & Vite artifacts
dist/
dist-ssr/
build/
.vite/
Client-Side/.vite/
*.local

# Logs and scratch output
logs/
*.log
Server-side/logs/
Client-Side/logs/
build_output*.txt
Client-Side/build_output*.txt

# Coverage and test artifacts
coverage/
e2e/.env.test
e2e/playwright-report/
e2e/test-results/
playwright-report/
test-results/

# OS and Editor artifacts
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker overrides
docker-compose.override.yml
